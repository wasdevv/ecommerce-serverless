# Dependências e artefatos
node_modules/
coverage/
build/
dist/
*.zip

# Segredos: nenhum .env real entra no git — só o exemplo.
.env
.env.*
!.env.example

# Terraform: state, planos e cache local nunca são versionados.
# O .terraform.lock.hcl SIM é versionado (fixa os hashes dos providers).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
*.tfvars.json
*.backend.hcl
!backend.hcl.example

.DS_Store
*.log

# Recomendador: dados exportados e modelos treinados localmente.
ml/data/
ml/model/
__pycache__/
