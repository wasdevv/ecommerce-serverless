# Copie para .env apenas se for rodar a API fora do docker compose.
# Nenhum valor aqui é segredo real — são defaults de desenvolvimento.
APP_ENV=local
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-dev-only-change-me
JWT_EXPIRES_IN=1h
ORDER_EVENTS_QUEUE_URL=http://localhost:9324/000000000000/order-events
AWS_ENDPOINT_URL_SQS=http://localhost:9324
UPLOADS_BUCKET=uploads
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret-key
OTEL_SERVICE_NAME=ecommerce-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Bootstrap de admin local (npm run bootstrap-admin). Sem default de propósito.
ADMIN_EMAIL=
ADMIN_PASSWORD=
